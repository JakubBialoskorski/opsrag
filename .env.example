# ./start.sh writes a minimal .env on first run. Everything here is optional,
# copy what you need into .env and run ./start.sh again.

# --- Running with Docker Compose ---

# Run Ollama in a container (Linux default) instead of on the host (macOS default)
# COMPOSE_PROFILES=ollama
# DOCKER_OLLAMA_URL=http://ollama:11434
# Add the NVIDIA GPU to the Ollama container
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml

# Where the web UI listens. 0.0.0.0 makes it reachable from your LAN, 127.0.0.1 keeps it local,
# [::] adds IPv6 (needed on IPv6-only servers, e.g. behind Cloudflare on a Mikrus)
# OPSRAG_BIND=127.0.0.1
# OPSRAG_PORT=8000
# POSTGRES_PASSWORD=opsrag

# --- Models and retrieval (used by the app in Docker and by `uv run opsrag`) ---

# EMBED_MODEL=nomic-embed-text
# EMBED_DIM=768
# DOC_PREFIX="search_document: "
# QUERY_PREFIX="search_query: "
# Use an instruct (non-thinking) model: thinking variants are slow and leak their reasoning
# CHAT_MODEL=qwen3:4b-instruct
# Ollama silently truncates prompts longer than the context window. A bigger window
# needs more RAM, 4096 fits 5 chunks + answer and keeps an 8 GB machine out of swap
# NUM_CTX=4096
# CANDIDATES=120
# The reranker reorders the best RERANK_POOL candidates, RERANK=false skips it
# RERANK_POOL=60
# RERANK=true
# Each chunk adds ~35 s of prompt reading on two CPU cores, fewer than 5 miss answers
# TOP_K=5

# --- Development outside Docker (`uv run opsrag ...`) ---

# OLLAMA_URL=http://localhost:11434
# DATABASE_URL=postgresql://opsrag:opsrag@localhost:5432/opsrag
